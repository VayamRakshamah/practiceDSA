class Solution {
    public boolean isPalindrome(String s) {
       String original =  s.toLowerCase().replaceAll("[^a-zA-Z0-9]","");
       char[] charList = original.toCharArray();
       int start = 0;
       int end = charList.length-1;
       while(start<end){
        if(charList[start]!=charList[end]){
            return false;
        }
        start++;
        end--;
       }
       return true;
    }
}



class Solution {
    public boolean isPalindrome(String s) {
        int left = 0;
        int right = s.length() - 1;

        while (left < right) {
            while (left < right && !Character.isLetterOrDigit(s.charAt(left))) {
                left++;
            }

            while (left < right && !Character.isLetterOrDigit(s.charAt(right))) {
                right--;
            }

            char c1 = Character.toLowerCase(s.charAt(left));
            char c2 = Character.toLowerCase(s.charAt(right));

            if (c1 != c2) {
                return false;
            }

            left++;
            right--;
        }

        return true;
    }
}
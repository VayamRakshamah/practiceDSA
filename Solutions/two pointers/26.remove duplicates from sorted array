class Solution {
    public int removeDuplicates(int[] nums) {
        int start = 0;
        int end = 0;
        int length=1;

        while (start< nums.length && end<nums.length){
            if(nums[start]==nums[end]){
                end++;
            }
            else{
                ++start;
                nums[start] = nums[end];
                length++;
            }
        }
        return length;
    }
}



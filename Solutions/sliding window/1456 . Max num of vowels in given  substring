class Solution {
    public int maxVowels(String s, int k) {
        int vowelCount = 0;
        String vowels = "aeiou";
        for(int i=0;i<k;i++){
            if (vowels.indexOf(s.charAt(i)) != -1) {
                vowelCount++;
            }
        }
        int maxVowel = vowelCount;
        for(int j=k;j<s.length();j++){
            if (vowels.indexOf(s.charAt(j)) != -1) {
                vowelCount++;
            }
            if (vowels.indexOf(s.charAt(j-k)) != -1) {
                vowelCount--;
            }
            maxVowel = Math.max(maxVowel,vowelCount);
        }
        return maxVowel;
    }
}
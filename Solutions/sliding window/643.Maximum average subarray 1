class Solution {
    public double findMaxAverage(int[] nums, int k) {
        //base case
        double sum = 0;
        for(int i=0;i<k;i++){
            sum+=nums[i];
        }
        double maxAverage = sum/k;
        // main code
        for(int j=k;j<nums.length;j++){
            sum = sum + nums[j] - nums[j-k];
            maxAverage = Math.max(maxAverage,(sum/k));
        }
        return maxAverage;
    }
}


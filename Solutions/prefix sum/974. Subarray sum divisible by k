class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        Map<Integer,Integer> sum = new HashMap<>();
        int currentSum=0;
        int count = 0;
        sum.put(0,1);
        for(int i=0;i<nums.length;i++){
            currentSum+=nums[i];
            int rem = ((currentSum % k) + k) % k;
            count += sum.getOrDefault(rem,0);
            sum.put(rem,sum.getOrDefault(rem,0)+1);
        }
        return count;
    }
}


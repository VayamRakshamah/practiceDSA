class Solution {
    public int subarraySum(int[] nums, int k) {
        int size = nums.length;
        int [] prefixsum = new int[size+1];
        prefixsum[0] = 0;
        for(int i=0;i<size;i++){
            prefixsum[i+1] = prefixsum[i]+nums[i];
        }
        int count =0;
        for(int i=0;i<size;i++){
            for(int j=i;j<size;j++){
                int sum = prefixsum[j + 1] - prefixsum[i];
                if(sum==k){
                    count++;
                }
            }
        }
        return count;
    }
}


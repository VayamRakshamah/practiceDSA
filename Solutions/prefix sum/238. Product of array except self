class Solution {
    public int[] productExceptSelf(int[] nums) {

        int mul = 1;
        int zero = 0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=0){
                mul*=nums[i];
            }else{
                zero++;
            }
        }
        int[] answer  = new int[nums.length];
        if(zero>1){
            return new int[nums.length];
        }else if(zero==1){
            for(int i=0;i<nums.length;i++){
                if(nums[i]==0){
                    answer[i] = mul;
                }
            }
        }else{
            for(int i=0;i<nums.length;i++){
                answer[i] = mul/nums[i];
            }
        }
        return answer;
    }
}

